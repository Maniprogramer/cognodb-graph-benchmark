# Secrets - never commit connection URIs or passwords
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Data artifacts: the dataset is rebuilt by `make dataset`, but the manifest
# (counts + SHA-256 of the canonical CSVs) is committed as proof that every
# platform loaded identical input.
data/*
!data/manifest.json
*.csv
*.csv.gz
*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/
