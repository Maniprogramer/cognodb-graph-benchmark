# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# CognoDB Cloud -- from https://console.cognodb.com after creating a free c0
# instance. The password is shown exactly once at provisioning time.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=
COGNODB_REGION=

# The four comparison platforms default to the local capped containers started
# by `make up`. Point them at managed endpoints to benchmark cloud tiers
# instead -- no code changes are needed.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmarkpw

MEMGRAPH_URI=bolt://localhost:7688

ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=benchmarkpw

FALKOR_HOST=localhost
FALKOR_PORT=6379
